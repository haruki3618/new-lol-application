# Riot Developer Portal で取得したAPIキー（開発キーは24時間で失効します）
# 失効したら再発行して、この行を書き換えて保存するだけで OK（再起動は不要です）
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# MongoDB の接続先
MONGODB_URI=mongodb://127.0.0.1:27017/lol-analytics

PORT=3000

# 起動時チェック（v6.8.0）: 数値でない値・知らない地域・前後の引用符や空白などがあると、起動を止めて一覧を出します。
# Render の Environment に貼るときは、値に引用符を付けないでください。本番（Render / GitHub Actions）では RIOT_API_KEY と MONGODB_URI が必須です

# 既定のリージョン（検索・統計で指定が無いときに使う）。jp / kr / na / euw / eune / br / lan / las / oce / tr / ru / me / ph / sg / th / tw / vn
# DEFAULT_REGION=jp
# クローラーが試合を集めるリージョン（既定は DEFAULT_REGION）。統計・ティアリストはリージョンごとに分けて集計されます
# CRAWLER_REGION=jp

# ---- データ容量の管理（v6.5） ----
# 試合データの保存日数（0 で無期限）。MongoDB の TTL インデックスが、期限を過ぎた試合を自動で削除します
MATCH_TTL_DAYS=30
# 保存件数の上限（0 で無制限）。超えたら古い順に削除（クローラーが確認）
MAX_MATCHES=20000
# データベース全体の容量の上限（MB。0 で無効）。超えたら DB_TARGET_PERCENT（%）まで古い試合から削除します。
# Atlas 無料枠（M0）は 512MB なので、400 前後にしておくと安全です
MAX_DB_MB=400
# DB_TARGET_PERCENT=85
# 容量の確認間隔（分。サーバー内。0 で確認しない）
# STORAGE_CHECK_MIN=30
# LP 履歴の保存日数 / 検索予測用のプレイヤー名の保存日数（0 で無期限）
# LP_TTL_DAYS=90
# PLAYER_TTL_DAYS=60
# v6.11.0: 週ごとのサマリー（試合が消えたあとも長期の推移を見るための合計）の保存日数（0 で無期限）。1 件あたり約 0.3KB
# PLAYER_WEEK_TTL_DAYS=365

# ---- 以下は必要なときだけ ----

# 1 にすると、旧バージョンの別名（RIOT_KEY / API_KEY / MONGO_URI など）を読まなくなります。
# .env を上の名前に直したら、事故防止のために 1 にすることをおすすめします
# STRICT_ENV=1

# APIの使用回数を MongoDB で共有する（サーバーとクローラーを別々に動かしても上限を超えない）。0 で無効
# RATE_SHARED=1

# リバースプロキシ（nginx など）の背後で公開するときだけ。段数を指定（例: 1）
# TRUST_PROXY=1

# 自サイトのIPごとのアクセス制限を、全体で何倍にするか（既定 1）
# WEB_RATE_SCALE=1

# 初期の上限（開発キーの値）。実行中は Riot が返すヘッダーから自動で更新されます
# RATE_LIMIT_1S=20
# RATE_LIMIT_120S=100

# ---- v5.2 の任意設定（書かなければ既定値） ----
# クローラーが起点にする帯（MASTER_PLUS,DIAMOND,EMERALD,PLATINUM,GOLD,SILVER）
# CRAWLER_BANDS=MASTER_PLUS,DIAMOND,EMERALD
# 1回の起点取得で、帯ごとに使う人数
# CRAWLER_SEEDS_PER_BAND=150
# ティアリストの最低試合数（ロール指定時は半分）
# TIER_MIN_GAMES=30
# スコア基準に必要な最低試合数（チャンピオン × ロール / ロール全体）
# BASELINE_MIN_CHAMP=30
# BASELINE_MIN_ROLE=200

# ---- v6.3 ----
# お気に入り追跡（Discord通知）の確認間隔（分）。0 で無効
# WATCH_INTERVAL_MIN=10

# ---- v6.5.1: お気に入り追跡の保護 ----
# Webhook URL を暗号化して保存するための秘密の文字列（長いランダム文字列。例: openssl rand -hex 32）。
# 変えると既存の登録を復号できなくなります。GitHub Actions（watch.yml）にも同じ値を Secrets として登録してください
# WEBHOOK_SECRET=
# 設定すると、/watch で追跡を追加するときに、この登録キーの入力が必要になります（公開サイトでの枠の独占・荒らし対策）
# WATCH_REGISTER_KEY=
# 1 にすると、追跡中のプレイヤー名を誰にでも一覧表示します（既定は件数だけ）
# WATCH_PUBLIC_LIST=0
# IP ごとの 追加 / 解除 の上限（1時間あたり）
# WATCH_ADD_PER_HOUR=5
# WATCH_REMOVE_PER_HOUR=10
# v6.6: 「過去の試合を読み込む」の IP ごとの 1 日あたりの上限（1回で最大300件の API を使う）
# HISTORY_PER_DAY=10
# v6.6: 同期の開始（Riot API を使う）の IP ごとの上限（1分あたり。進捗確認は別枠）
# SYNC_START_PER_MIN=30
# ユーザー操作が使える Riot API の割合（既定 0.85。残りをクローラー・追跡の余裕にする）
# RATE_HIGH_RATIO=0.85

# ---- v6.4.1: 公開運用 ----
# サイト全体を ID/パスワードで守る（公開の許可が下りるまで使う。空なら無効。/healthz は対象外）
# SITE_USER=admin
# SITE_PASSWORD=
# クローラーを自動で止めるまでの分数（GitHub Actions の定期実行用。0 で無制限）
# CRAWLER_MAX_MINUTES=330
