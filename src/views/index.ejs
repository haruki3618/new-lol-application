<%- include('_head', { title: 'ホーム', active: '', hideNavSearch: true }) %>
<% const regionLabel = (locals.regions && locals.regions[locals.formRegion]) ? locals.regions[locals.formRegion].label : 'JP'; %>
<section class="hero">
  <h1>LoL 戦績解析</h1>
  <p class="mute lead">Riot ID とリージョンを選んで、試合・ランク・チャンピオンを一度に確認</p>
  <form class="searchbox" action="/search" method="post">
    <%- include('_region_select') %>
    <input type="text" name="riotId" placeholder="ゲーム名#タグ" aria-label="Riot ID" autocomplete="off" required data-riotid value="<%= locals.riotId || '' %>"<% if (error) { %> aria-invalid="true" aria-describedby="searchError"<% } %>>
    <button>検索</button>
  </form>
  <% if (error) { %><div class="alert u3" id="searchError" role="alert"><%= error %></div><% } %>
  <div class="recent" data-recent hidden aria-label="最近の検索"></div>
  <div class="flex jc aic g12 wrapf mt16 sm">
    <% if (statusInfo) { %>
      <a href="/status" class="badge <%= statusInfo.issues ? 'lose' : 'win' %>"><%= statusInfo.issues ? '⚠ 障害・メンテナンス ' + statusInfo.issues + '件' : '● サーバー正常' %></a>
    <% } %>
    <span class="mute">保存済みの試合 <b class="num u4"><%= matchCount.toLocaleString('ja-JP') %></b> 件</span>
  </div>
</section>

<%
  const featMain = [
    ['/champions', 'チャンピオン統計', '勝率・ピック率・おすすめルーン／ビルド・対面。図鑑とスキル解説つき'],
    ['/tierlist', 'ティアリスト', 'ロール別・ランク帯別の強さをティアで一覧'],
    ['/ranking', 'ランキング', 'アイアンからチャレンジャーまで、ティア別の順位表']
  ];
  const featMore = [
    ['/multi', 'マルチ検索', '最大5人を並べてランクと得意チャンピオンを比較'],
    ['/duo', 'デュオ比較', '2人で組んだときの勝率と相性を確認'],
    ['/watch', 'お気に入り', '気になるプレイヤーのランク変動をまとめて確認'],
    ['/items', 'アイテム', 'ビルド素材・完成品・効果の検索'],
    ['/status', 'サーバー状況', 'メンテナンスと障害の最新情報']
  ];
%>
<section class="feat-main">
  <% featMain.forEach(c => { %>
    <a class="card-link" href="<%= c[0] %>"><div class="b"><%= c[1] %></div><div class="sm mute"><%= c[2] %></div></a>
  <% }) %>
</section>
<section class="feat-more">
  <% featMore.forEach(c => { %>
    <a class="card-link" href="<%= c[0] %>"><div class="b"><%= c[1] %></div><div class="sm mute"><%= c[2] %></div></a>
  <% }) %>
</section>
<%- include('_foot') %>
